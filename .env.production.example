# Copy to .env.production on the server (never commit the real file). See docs/DEPLOY.md for where each value comes from.
# No quotes around values, one value per line.

# ── Required
DATABASE_URL=
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_TO=
MAIL_FROM=

# ── Optional second admin (up to _5)
# ADMIN_EMAIL_2=
# ADMIN_PASSWORD_HASH_2=

# ── Photo storage on a VPS: nothing to set — photos are kept in the "uploads" volume (UPLOAD_DIR).
# Only set one of these if you prefer cloud storage instead:
# GCS_BUCKET=
# BLOB_READ_WRITE_TOKEN=
