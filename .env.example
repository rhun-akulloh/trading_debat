# ── Public URL (set BEFORE building; used for sitemap, social previews, structured data)
NEXT_PUBLIC_SITE_URL=https://debaattrading.nl

# ── Email: REQUIRED in production so orders and enquiries reach the inbox.
# Without SMTP_HOST the order/contact APIs return 503 in production (they never silently drop an order).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: defaults to "De Baat Trading <info@debaattrading.nl>"
MAIL_FROM=
# Optional: where order/enquiry notifications go (defaults to info@debaattrading.nl)
MAIL_TO=

# ── Admin area (/admin): product management ─────────────────────────────
# Without these, /admin shows "login not configured".
ADMIN_EMAIL=
# Generate with:  npm run admin:hash -- "a long password"
ADMIN_PASSWORD_HASH=
# One random secret for the whole site (printed by the command above for admin 1)
AUTH_SECRET=
# More admins (optional, up to _5). Each person gets their own e-mail + password:
#   npm run admin:hash -- "their long password" --slot 2
ADMIN_EMAIL_2=
ADMIN_PASSWORD_HASH_2=

# ── Product database (Neon Postgres). Without it the admin is read-only.
# Neon dashboard → Connection details → copy the pooled connection string.
DATABASE_URL=

# ── Product photo storage — set ONE of these (first one found wins). Without any, production cannot upload photos.
#   Vercel:        Vercel project → Storage → Blob → connect; the token is added for you.
BLOB_READ_WRITE_TOKEN=
#   Google Cloud:  name of a public-read bucket; Cloud Run's service account needs "Storage Object Admin" on it.
GCS_BUCKET=
#   VPS / Docker:  a folder on the server's disk (the Docker image already sets /data/uploads — mount a volume there).
UPLOAD_DIR=
